Player = proto struct SceneObject & Animable & (
    health : Real
    strength : Real
)

hurt(@targetPlayer : Player, amount : Real) => {
    if amount >= health'targetPlayer {
        @health'targetPlayer = 0
        @lives'targetPlayer - 1
        playAnim(@targetPlayer, "Dying")
    } else {
        @health'targetPlayer - amount
        /* ^ Equivalent to: @health'targetPlayer = health'targetPlayer - amount */

        if amount < 40 {
            playAnim(@targetPlayer, "Hit")
        } else {
            playAnim(@targetPlayer, "Pain")
        }
    }
}

attack(@attacker : Player, @target : Player) => {
    playAnim(@attacker, "SwordSwing")
    hurt(@target, strength'attacker)
}

action(@myPlayer : Player, @otherPlayer : Player) => {
    attack(@myPlayer, @otherPlayer)

    /*
    LONGER: attack(attacker = @myPlayer, target = @otherPlayer)
    EXPLICIT: (@myPlayer = attacker, @otherPlayer = target) = attack(attacker = rel myPlayer, target = rel otherPlayer)
    **/
}