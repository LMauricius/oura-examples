use Listable mod Core

DoublyLinkedList = proto Listable & (
        Item : proto Any
        
        given use self {
            count() => Size {
                res! = 0

                for items'self {
                    res! +1
                }

                out res
            }

            items() => Generator'Item {
                cur! = @head'self

                while use @ListNode'cur {
                    over value'cur
                    cur! = @next'cur
                }
            }
        }

        given use self! {
            push(value : Item) => {
                if use tail'self as ListNode {
                    next'tail! = ListNode( 
                        use rel value
                        prev = @tail
                        next = None
                    )

                    tail! = @next'tail
                } else {
                    head'self = ListNode(
                        use rel value
                        prev = None
                        next = None
                    )

                    tail'self! = @head'self
                }
            }

            pop() where head'self is not None => Item {
                ret = rel value'tail'self
                
                if secondToLast = @ListNode'prev'tail'self {
                    next'secondToLast! = None
                    tail'self! = @secondToLast
                } else {
                    tail'self! = None
                }

                out ret
            }

            push_front(value : Item) => {
                head'self! = ListNode(
                    use rel value
                    prev = None
                    next = rel head'self
                )
            }

            pop_front() if head'self is not None => Item {
                ret = rel value'head'self
                next = rel next'head'self
                head'self! = rel next
                prev'head! = None

                out ret
            }
        }
    ) & struct _(
        head : ListNode from rel this | None
        tail : ListNode from head | None

        ListNode = proto struct(
            value: Item
            prev: ListNode from (head & not next) | None
            next: ListNode from rel this | None
        )
    )