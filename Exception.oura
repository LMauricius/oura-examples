=(ABIMod, CatchStack, CatchLookUp).ABI.Core

Exceptional(E : Any) => proto ABIMod((storage = CatchStack), E)

Unexpected(E : Any) => proto ABIMod((storage = CatchLookUp), E)

DivByZero = Exceptional'class

divided(a : ArgTrait, b : ArgTrait, ArgTrait : proto Number) => ArgTrait|DivByZero{
    if b ?= ArgTrait'0 {
        === DivByZero
    } else {
        === a / b
    }
}