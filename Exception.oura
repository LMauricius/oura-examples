import (ABISpec, CatchStack, CatchLookUp) module ABI Core

exceptional[E = Any] => E & ABISpec@[storage = CatchStack]

unexpected[E = Any] => E & ABISpec@[storage = CatchLookUp]

DivByZero = exceptional class

divided[a = ArgT, b = ArgT, ArgT = auto Number] => (ArgT|DivByZero)@:
    if b ?= ArgT@0:
        break DivByZero
    :: else:
        break a / b
    ::
::
