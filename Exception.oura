import (ABISpec, CatchStack, CatchLookUp) module ABI Core

exceptional[E: proto Any] =>> proto E & @ABISpec[storage = CatchStack]

unexpected[E: proto Any] =>> proto E & @ABISpec[storage = CatchLookUp]

DivByZero = exceptional class

divided[a: ArgT, b: ArgT, ArgT: proto Number = auto] =>> {
    if b ?= @ArgT 0 {
        break = DivByZero
    } else {
        break = a / b
    }
}
