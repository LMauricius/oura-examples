use (CatchStack, CatchLookUp) mod ABI.Core

Exceptional(E : Any) => proto E # CatchStack
Unexpected(E : Any) => proto E # CatchLookUp

DivByZero = Exceptional'class

divided(a : ArgTrait, b : ArgTrait, ArgTrait : proto Number) => ArgTrait|DivByZero {
    if b ?= ArgTrait'0 {
        out DivByZero
    } else {
        out a / b
    }
}