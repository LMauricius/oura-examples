import [ABISpec, CatchStack, CatchLookUp] module ABI Core

exceptional{E: Any} => proto E & ABISpec@{storage = CatchStack}

unexpected{E: Any} => E & ABISpec@{storage = CatchLookUp}

DivByZero = exceptional class

divided{a: ArgT, b: ArgT, ArgT: proto Number = auto} => ArgT|DivByZero@:
    if b ?= ArgT@0:
        return DivByZero
    :: else:
        return a / b
    ::
::
