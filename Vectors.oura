$.Math.Std
$exceptional.Exception
$(TextStream, DeserializationError).IO.Std

Vector3 = proto struct(
    x : Float32
    y : Float32
    z : Float32
)

ZERO3 = Vector3(
    x = 0.0
    y = 0.0
    z = 0.0
)

length(vec : Vector3) => sqrt.Math(x'vec^2 + y'vec^2 + z'vec^2)

normalized(vec : Vector3 & non'ZERO3) => Vector3{
    l = length'vec
    return (x'vec / l, y'vec / l, z'vec / l)
}

InvalidVectorError = exceptional'class

deserializeNormal(@ts : var TextStream) => Vector3|DeserializationError|InvalidVectorError {
    x = read(@ts, Float32)
    y = read(@ts, Float32)
    z = read(@ts, Float32)

    Float32 $(x, y, z) except return DeserializationError

    vec = Vector3(x, y, z)

    if (Vector3 & non'ZERO3)$vec {
        return normalized'vec
    } except return InvalidVectorError
}