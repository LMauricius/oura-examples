use mod Math.Std
use exceptional mod Exception
use (TextStream, DeserializationError) mod IO.Std

Vector3 = proto struct(
    x : Float32
    y : Float32
    z : Float32
)

ZERO3 = Vector3(
    x = 0.0
    y = 0.0
    z = 0.0
)

length(vec : Vector3) => sqrt(mod Math, x'vec^2 + y'vec^2 + z'vec^2)

normalized(vec : Vector3 & non'ZERO3) => Vector3{
    l = length'vec
    out (x'vec / l, y'vec / l, z'vec / l)
}

InvalidVectorError = exceptional'class

deserializeNormal(@ts : var TextStream) => Result'Vector3|DeserializationError|InvalidVectorError {
    x = read(@ts, Float32)
    y = read(@ts, Float32)
    z = read(@ts, Float32)

    use (x, y, z) as Float32 else {
        out DeserializationError
    }

    vec = Vector3(x, y, z)

    if use vec as Vector3 & non'ZERO3 {
        out normalized'vec
    } else {
        out InvalidVectorError
    }
}