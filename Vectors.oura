import module Math Std
import exceptional module Exception
import GoodResult module Core
import [TextStream, DeserializationError] module IO Std

Vector3 = proto {
    x: Float32
    y: Float32
    z: Float32
}

ZERO3 = Vector3@{
    x = 0.0
    y = 0.0
    z = 0.0
}

length{vec: Vector3} => (sqrt Math)(x vec^2 + y vec^2 + z vec^2)

normalized{vec: Vector3 & non ZERO3} => Vector3@:
    l = length vec
    return [x vec / l, y vec / l, z vec / l]
::

InvalidVectorError = exceptional class

deserializeNormal{ts: var TextStream} => {
    res: (Vector3 & GoodResult)|DeserializationError|InvalidVectorError
    s: var TextStream
}@:
    ts! x = read Float32
    ts! y = read Float32
    ts! z = read Float32

    vec = Vector3@[good x, good y, good z] except return [DeserializationError, ts]

    using (Vector3 & non ZERO3)@vec:
        return [normalized vec & GoodResult, ts]
    :: except return [InvalidVectorError, ts]
::