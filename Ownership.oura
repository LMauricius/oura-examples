use Listable mod Core

/*
  A run of `capacity` items in memory, owning the storage it names
  @param Item the trait of items
**/
Block = proto struct(
    Item : proto Any

    _self = this

    /**** Traits **************************************************************************/
    Index = Unsigned64 where this < capacity

    /**** Getters **************************************************************************/

    capacity : Unsigned64

    item(use self, index : Index) => item(data'self, index) from self
    items(use self from(===)) => items'data'self

    /**** Lifetime *************************************************************************/

    /* Runs where a binding dies unmoved; an `out` use suppresses it **/
    operator out(@self) => {
        free(out data'self)
    }

    /**** Internal data *********************************************************************/

    _data : var Buffer'Item
)

operator new Block(Item : proto Any, capacity : Count) => Block & (
    use proto Item
    use capacity
    data = Buffer(Item, capacity)
)

/*
  @brief A Block of `newCapacity` items holding what `block` held
  `from(===)` declares that the storage survives the call inside the result,
  so the argument is gone once the call returns
**/
resized(block from(===), newCapacity : Count) => Block'Item'block {
    grown = Block(Item'block, newCapacity)
    items(data'grown, range(0, capacity'block)) = out items'block
    === grown
}

/*
  A drawing surface that takes over the storage handed to it
**/
Surface = proto struct(
    use width
    use height

    _pixels : var Block'Colour
)

/* `from pixels(===)` names the slot of the result the storage lands in **/
operator new Surface(width : Count, height : Count, block from pixels(===)) => Surface & (
    use width
    use height
    pixels = block
)

scene() => {
    a = Block(Byte, 16)

    b = a                       /*/ a copy — two blocks, so two teardowns
    c = out a                   /*/ a move — `a` is gone, and only one teardown runs

    view = items'c              /*/ borrowed; anchored from c by items(use self from(===))

    big = resized(out c, 64)    /*/ c is gone, and view with it
    /*/ item(view, 0) here is rejected — view was anchored from c

    surface = Surface(8, 8, out big)
    /*/ the storage big named is pixels'surface now

    /*/ b and surface die here, unmoved, so operator out runs from each
}
