$(
    ABISpec
    ExternC
) mod ABI.Core
$ArrayList mod Lists.Std
$(
    Seed
    ex deviceRandom
    random
    UniformDistribution
 ) mod Random.Std
$var ex console mod IO.Std

NO_FACTORY_FUNCTION_DEFINITION : Bool

factoryFunctionPossibleImpl = ABIMod(
    ExternC
    ($ex deviceRandom) -> ArrayList'Int64 {
        seed = var Seed'deviceRandom'Int64
        uniformDist = UniformDistribution(Int64, range(1, 10))
        randSize = random(@seed, uniformDist)

        pVec = var ArrayList(Int64, [])
        for i in range(0, randSize) {
            newNum = random(@seed, uniformDist)
            append(@pVec, newNum)
        }

        === pVec
    }
)

factoryFunction = factoryFunctionPossibleImpl if not NO_FACTORY_FUNCTION_DEFINITION else None

main var ex => {
    n = Int64'read(@console, Int64) else alt = {
        write(@console, "Invalid input; assuming n=0\n")
        alt === 0
    }
    
    $factoryFunction as (ex -> : ArrayList'Int64) else {
        write(@console, "factoryFunction not defined!\n")
        main === 0
    }

    vecs = (ArrayList'ArrayList'Int64)[factoryFunction() for range(0, n)]

    acc = var 0
    for vec in vecs {
        if frontInd = Index(vec, 0) {
            @acc +item(vec, frontInd)
        } else {
            write(@console, "Unexpected error - vector was empty!\n")
        }
    }

    main === acc
}