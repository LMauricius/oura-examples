import ABISpec module ABI Core
import ArgumentList module Program Std
import ArrayList module Lists Std
import (
    Seed
    deviceRandom
    random
    UniformDistribution
) module Random Std
import (
    console
    read
    write
) module IO Std

NO_FACTORY_FUNCTION_DEFINITION: Bool

factoryFunctionPossibleImpl = ([import deviceRandom] >> @(ArrayList Int64){
    seed: var = @Seed deviceRandom Int64
    uniformDist = @(UniformDistribution Int64)range[1, 10]
    seed! randSize = random uniformDist

    pVec: var = @(ArrayList Int64)[]
    for i in range[0, randSize] {
        seed! newNum = random uniformDist
        pVec! append newNum
    }

    break = pVec
}) & @ABISpec[symbol = "factoryFunctionPossibleImpl"]

factoryFunction = factoryFunctionPossibleImpl if not NO_FACTORY_FUNCTION_DEFINITION else None

main ArgumentList =>> @IntNative until End{
    console! n = good read Int64 except {
        console! write "Invalid input; assuming n=0\n"
        break = 0
    }

    import @([import deviceRandom] -> ArrayList Int64)factoryFunction except {
        console! write "factoryFunction not defined!\n"
        break End = 0
    }

    vecs = @(ArrayList ArrayList Int64) |>{
        for range[0, n] {
            yield factoryFunction[]
        }
    }

    acc: var = 0
    for vec in vecs {
        using frontInd = @(Index vec)0 {
            acc! +item[vec, frontInd]
        } except {
            console! write "Unexpected error - vector was empty!\n"
        }
    }

    break End = acc
}