ProtoRecord = proto(
    f::(Real, Int) :> Real
    g::(Real, Count) :> Real
    h(Real, Count)::Real
)

ImplRecord = ProtoRecord@(
    f = (x, y) -> x * y
    g = (x, p) -> :
        res = var x

        repeat p - 1:
            res! * x
        ----

        return res
    ----

    h(a, d) => a / d
)

terseFunc(a::Real, b::Real) => a + b
terseRoutine(c::Int, d::Int) => Real@:
    m = c * d
    s = c + d
    return m / s
----