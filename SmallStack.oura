/-
  A stack of entries that can be pushed or popped
-/
AnyStack = proto Listable & (
    Item $proto Any

    _self = this

    ---- Traits ----------------------------------------------------------------
    Index = Unsigned64 where this < count
    Empty = self where count'self ?= 0

    ---- Getters ----------------------------------------------------------------
    count(import self) -> Count64

    item(import self, index $Index) -> Item
    operator item=(import var self, index $Index, value $Item) -> None

    ---- Methods ----------------------------------------------------------------

    push(import var self, value $Item'self) => $None
    pop(import var self, value $Item'self) where self is non'Empty => $Item

    pop(import var self, value $Item'self) => $Item

    concat(import var self, lists $Listable'Listable'Item) => $Listable'Listable'Item
)

--- A stack of Items optimized for small amount of entries
--- @param Item the trait of items
SmallStack = proto AnyStack & struct(
    _self = this

    ---- Getters ----------------------------------------------------------------

    import capacity
    import count

    items(import self out stop) => items'data'self

    item(import self, index $Index) => item(data'self, index)
    operator item(import var self, index $Index) = (value $Item) => {
        item(data'self, index) = value
    }

    ---- Methods ----------------------------------------------------------------

    push(import var self, value $Item'self) => {
        ensureCapacity(count'self + 1)

        oldItems = Array'data'self
        @count'self + 1 --- invalidates data'self
        data'self = PreallocBuffer'concat(oldItems, value)
    }

    pop(import var self, value $Item stacsk) => Item'{
        ret = item(data'self, count'self - 1)

        oldItems = Array'items(data'self, range(0, count'self - 1))
        @count'self -1 --- invalidates data'self
        data'self = PreallocBuffer'oldItems

        return ret
    }

    concat(import var self, lists $Listable'Listable'Item) => {
        newValuesCount = sum[count'list for list in lists]

        oldItems = filled'data'self
        @count'self + newValuesCount --- invalidates data'self
        data'self = PreallocBuffer'concat(oldItems, concat'lists)
    }

    ---- Internal data ----------------------------------------------------------

    SMALL_COUNT $Count

    _count $var Unsigned64
    _capacity $var Unsigned64
    _data $var PreallocBuffer

    ---- Internal Helpers ------------------------------------------------------

    --- @returns Whether we need SOO
    _UsingSmall = self where capacity <= SMALL_COUNT

    --- @brief Bytes for unset values
    _ItemBytes = GarbageBytes(import size'Bytes'Item)

    --- @brief A buffer holding `count` items, reserved for `capacity` items
    _PreallocBuffer = proto struct Array(Item, count) &
        & MinSized(Memory, SMALL_COUNT * size'Bytes'Item)

    --- @brief Ensures that the stack has enough memory for the capacity,
    --- without modifying the items
    _ensureCapacity(import var self, minCapacity $Unsigned64) => {
        if capacity'self < minCapacity and minCapacity > SMALL_COUNT'self {
            oldItems = Array'data'self
            capacity'self = minCapacity
            data'self = PreallocBuffer'oldItems
        }
    }
)

DEFAULT_SMALL_COUNT = Count'16

operator SmallStack(Item $proto Any) => proto SmallStack(Item, DEFAULT_SMALL_COUNT)

SmallStack(Item $proto Any, SMALL_COUNT $Count) => proto SmallStack(
    import proto Item
    import SMALL_COUNT
)

operator SmallStack(list $Listable) => SmallStack(list, DEFAULT_SMALL_COUNT)

operator SmallStack(list $Listable, SMALL_COUNT $Count) => SmallStack & (
    Item = proto Item'list
    import SMALL_COUNT
    count = count'list
    capacity = count'list
    data = PreallocBuffer'items'list
)