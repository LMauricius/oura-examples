## A stack of Items optimized for small amount of entries
## @param Item the trait of items
SmallStack = proto @ Listable Item & struct{
    Item ~ proto Any
    SMALL_COUNT ~ Count

    _self = local

    #### Traits ################################################################
    Index = Unsigned64 & req(local < count) in count

    #### Getters ###############################################################

    import capacity
    import count

    items{import self out yield} =>...
        for item in filled data self:
            yield item
        ::
    ::

    item{import self, index ~ Index} => item(filled data self, index)
    \= item{import var self, index ~ Index, value ~ Item} => :
        item(filled data self, index) = value
    ::

    isEmpty{import self} => whether count self ?= 0

    #### Methods ###############################################################

    push{import var self, value ~ Item self} => :
        self! ensureCapacity(count self + 1)

        old = filled data self
        count self! +1 # invalidates data self
        data self = PreallocBuffer(self, count self, minCapacity) @
            @ concat[old, [value]]
    ::

    pop{import var self, value ~ Item stacsk} => Item@:
        ret = item(filled data self, count self - 1)

        old = items(filled data self, range(0, count self - 1))
        count self! -1 # invalidates data self
        data self = PreallocBuffer(self, count self, minCapacity)@old

        return ret
    ::

    concat{import var self, values ~ Listable Item} => :
        self! ensureCapacity(count self + 1)

        old = filled data self
        count self! + count values # invalidates data self
        data self = PreallocBuffer(self, count self, minCapacity) @
            @ concat[old, values]
    ::

    #### Internal data #########################################################

    _count ~ var Unsigned64 out data
    _capacity ~ var Unsigned64 out data
    _data ~ var (
        (PreallocBuffer(count, SMALL_COUNT) & req usingSmall self) |
        | (PreallocBuffer(count, capacity) & req not usingSmall self)
    )

    #### Internal Helpers ######################################################

    ## @returns Whether we need SOO
    _usingSmall{import self} = capacity self <= SMALL_COUNT self

    ## @brief Bytes for unset values
    _ItemBytes = GarbageBytes{import size(Bytes@Item)}

    ## @brief A buffer holding `count` items, reserved for `capacity` items
    _PreallocBuffer{import self, count ~ Count, capacity ~ Count} = proto struct{
        filled ~ Array@(Item, count)
        reserved = Array@(ItemBytes, capacity - count)
    }

    ## @brief Ensures that the stack has enough memory for the capacity,
    ## without modifying the items
    _ensureCapacity{import var self, minCapacity ~ Unsigned64} => :
        if capacity self < minCapacity and minCapacity > SMALL_COUNT self:
            old = filled data self
            capacity self = minCapacity
            data self = PreallocBuffer(self, count self, minCapacity)@old
        ::
    ::

    

}