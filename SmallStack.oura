use Listable mod Core

/*
A buffer with preallocated capacity. Optimized for growth up to CAPACITY
*/
_PreallocBuffer = proto Listable & (
        Item : proto Any
        CAPACITY : Count

        self = this
        count : Unsigned64 where this <= CAPACITY
        freeCount = CAPACITY - count
    ) & (
        struct

        filledItems : Array(Item, count)
        freeItems = GarbageBytes'freeCount
    ) & (
        given use self! {
            append(items : Listable'Item where count'this <= freeCount'self) => {
                oldItems = rel filledItems'self
                count'self! +count'items
                filledItems'self! = concat(oldItems, items)
            }

            remove(count : Unsigned64 where this <= count'self) => {
                oldItems = items(rel filledItems'self, count'self - count)
                count'self! -count
                filledItems'self! = oldItems
            }
        }
    )

/*
  A stack of entries that can be pushed or popped
**/
AnyStack = proto Listable & (
    Item : proto Any

    _self = this

    /**** Traits **************************************************************************/
    Index = proto Unsigned64 where this < count

    /**** Getters **************************************************************************/
    given use self {
        count => : Count64

        item(index : Index) => : Item from self
    }

    /**** Methods **************************************************************************/

    given use self! {
        push(value : Item'self) => : None
        pop where self is non'Empty => : Item
        operator item=(index : Index, value : Item) => : None
        concat(lists : Listable'Listable'Item) => : None
    }
)

Empty'AnyStack => proto AnyStack where count'this ?= 0

/*
  A stack of Items optimized for small amount of entries
  @param Item the trait of items
**/
SmallStack = proto AnyStack & struct(
    _self = this

    SMALL_COUNT : Count
    count : Unsigned64 by CountChange
    capacity : Unsigned64 by CountChange

    _CountChange = Any
    
    given use self {
        items => items'data'self from self

        item(index : Index) => item(data'self, index) from self
    }
    
    given use self! {
        operator item=(index : Index, value : Item) => {
            item(data'self!, index) = value
        }

        push(value : Item'self) => {
            ensureCapacity(self!, count'self + 1)

            oldItems = rel data'self
            count'self! + 1 /*/ invalidates data'self
            data'self! = concat[rel oldItems, [value]]
        }

        pop => Item {
            ret = item(data'self, count'self - 1) /*/ copied out before the buffer goes

            oldItems = Array'items(rel data'self, range(0, count'self - 1))
            count'self! -1 /*/ invalidates data'self
            data'self! = rel oldItems

            out ret
        }

        concat(lists : Listable'Listable'Item) => {
            newValuesCount = sum[count'list for list in lists]

            oldItems = rel data'self
            count'self! + newValuesCount /*/ invalidates data'self
            data'self! = concat[rel oldItems, l for l in lists]
        }
    }

    /* @returns Whether we need SOO **/
    _UsingSmall = self where capacity <= SMALL_COUNT

    /* @brief A buffer holding `count` items, optimized for `capacity` items **/
    _OptiBuffer = (
        proto struct
        PreallocBuffer(Item, SMALL_COUNT) if self is UsingSmall
        else (PreallocBuffer(Item, capacity) from rel this)
    )

    _items : OptiBuffer
    
    /*
      @brief Ensures that the stack has enough memory for the capacity,
      without modifying the items
    **/
    _ensureCapacity(use self!, minCapacity : Unsigned64 where this <= count'self) => {
        if capacity'self < minCapacity {
            oldItems = rel data'self
            capacity'self! = minCapacity
            items'self! = rel oldItems
        }
    }
)

DEFAULT_SMALL_COUNT = Count'16

operator new SmallStack(Item : proto Any) => proto SmallStack(Item, DEFAULT_SMALL_COUNT)

operator new SmallStack(Item : proto Any, SMALL_COUNT : Count) => proto SmallStack(
    use proto Item
    use SMALL_COUNT
)

operator new SmallStack(list : Listable) => SmallStack(list, DEFAULT_SMALL_COUNT)

operator new SmallStack(list : Listable, SMALL_COUNT : Count) => SmallStack & (
    Item = proto Item'list
    use SMALL_COUNT
    count = count'list
    capacity = count'list
    data = PreallocBuffer'items'list
)