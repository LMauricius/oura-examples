/-
  A stack of entries that can be pushed or popped
-/
AnyStack = proto Listable & struct(
    Item $proto Any

    _self = this

    ---- Traits ----------------------------------------------------------------
    Index = Unsigned64 where this < count

    ---- Getters ----------------------------------------------------------------
    :count(import self) -> Count64

    :item(import self, index $Index) -> Item
    :operator item=(import var self, index $Index, value $Item) -> None

    ---- Methods ----------------------------------------------------------------

    :push(import var self, value $Item.self) -> None
    :pop(import var self, value $Item.self) where not isEmpty.self -> Item

    pop(import var self, value $Item stacsk) -> Item => {
        ret = item(filled.data.self, count.self - 1)

        old = items(filled.data.self, range(0, count.self - 1))
        count.self! -1 -- invalidates data.self
        data.self = (
            count = count.self
            capacity = capacity.self
            filled = old
        )

        return ret
    }

    concat(import var self, lists $Listable.Listable.Item) => {
        newValuesCount = sum[count.list for list in lists]

        old = filled.data.self
        @count.self + newValuesCount -- invalidates data.self
        data.self = (
            count = count.self
            capacity = count.self + newValuesCount
            filled = concat(old, concat.lists)
        )
    }

    ---- Internal data ----------------------------------------------------------

    _count $var Unsigned64
    _capacity $var Unsigned64
    _data $(
        (count, SMALL_COUNT) as proto PreallocBuffer if usingSmall.self
        else (count, capacity) as proto PreallocBuffer
    ) var 

    ---- Internal Helpers ------------------------------------------------------

    // @returns Whether we need SOO
    _usingSmall(import self) = True if capacity.self <= SMALL_COUNT.self else False

    -- @brief Bytes for unset values
    _ItemBytes = GarbageBytesOf(import size(Item as proto Bytes))

    -- @brief A buffer holding `count` items, reserved for `capacity` items
    _PreallocBuffer = proto struct(
        import (Item, ItemBytes)

        count $Count
        capacity $Count
        filled $ArrayOf(Item, count)
        reserved = ArrayOf(ItemBytes, capacity - count)
    )

    -- @brief Ensures that the stack has enough memory for the capacity,
    -- without modifying the items
    _ensureCapacity(import var self, minCapacity $Unsigned64) => {
        if capacity.self < minCapacity and minCapacity > SMALL_COUNT.self {
            oldItems = filled.data.self
            capacity.self = minCapacity
            data.self = (count.self, minCapacity, oldItems)
        }
    }
)

:isEmpty(s $AnyStack) => True if count.s ?= 0 else False


-- A stack of Items optimized for small amount of entries
-- @param Item the trait of items
SmallStack = proto Listable.Item & struct(
    Item $proto Any
    SMALL_COUNT $Count

    _self = this

    ---- Traits ----------------------------------------------------------------
    Index = Unsigned64 where this < count

    ---- Getters ----------------------------------------------------------------

    import capacity
    import count

    :items(import self out stop) => {
        for item in filled.data.self{
            stop item
        }
    }

    :item(import self, index $Index) => item(filled.data.self, index)
    operator item(import self, index $Index) = (value $Item) => {
        item(filled.data.self, index) = value
    }

    isEmpty(import self) => True if count.self ?= 0 else False

    ---- Methods ----------------------------------------------------------------

    push(import var self, value $Item.self) => {
        ensureCapacity(count.self + 1)

        oldItems = filled.data.self
        @count.self + 1 -- invalidates data.self
        data.self = PreallocBuffer@(
            count = count.self
            capacity = minCapacity
            filled = concat(oldItems, (value))
        )
    }

    pop(import var self, value $Item stacsk) -> Item => {
        ret = item(filled.data.self, count.self - 1)

        oldItems = items(filled.data.self, range(0, count.self - 1))
        count.self! -1 -- invalidates data.self
        data.self = PreallocBuffer@(
            count = count.self
            capacity = capacity.self
            filled = oldItems
        )

        return ret
    }

    concat(import var self, lists $Listable.Listable.Item) => {
        newValuesCount = sum[count.list for list in lists]

        oldItems = filled.data.self
        @count.self + newValuesCount -- invalidates data.self
        data.self = (
            count = count.self
            capacity = count.self + newValuesCount
            filled = concat(oldItems, concat.lists)
        )
    }

    ---- Internal data ----------------------------------------------------------

    _count $var Unsigned64
    _capacity $var Unsigned64
    _data $(
        (count, SMALL_COUNT) as proto PreallocBuffer if usingSmall.self
        else (count, capacity) as proto PreallocBuffer
    ) var 

    ---- Internal Helpers ------------------------------------------------------

    -- @returns Whether we need SOO
    _usingSmall(import self) = True if capacity.self <= SMALL_COUNT.self else False

    -- @brief Bytes for unset values
    _ItemBytes = GarbageBytesOf(import size(Item as proto Bytes))

    -- @brief A buffer holding `count` items, reserved for `capacity` items
    _PreallocBuffer = proto struct(
        import (Item, ItemBytes)

        count $Count
        capacity $Count
        filled $ArrayOf(Item, count)
        reserved = ArrayOf(ItemBytes, capacity - count)
    )

    -- @brief Ensures that the stack has enough memory for the capacity,
    -- without modifying the items
    _ensureCapacity(import var self, minCapacity $Unsigned64) => {
        if capacity.self < minCapacity and minCapacity > SMALL_COUNT.self {
            oldItems = filled.data.self
            capacity.self = minCapacity
            data.self = (count.self, minCapacity, oldItems)
        }
    }
)