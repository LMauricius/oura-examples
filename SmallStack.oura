use Listable mod Core

/*
  A stack of entries that can be pushed or popped
**/
AnyStack = proto Listable & (
    Item : proto Any

    _self = this

    /**** Traits **************************************************************************/
    Index = Unsigned64 where this < count
    Empty = self where count'self ?= 0

    /**** Getters **************************************************************************/
    count(use self) => : Count64

    item(use self, index : Index) => : Item from self
    operator item=(@self, index : Index, value : Item) => : None

    /**** Methods **************************************************************************/

    push(@self, value : Item'self) => : None
    pop(@self) where self is non'Empty => : Item

    concat(@self, lists : Listable'Listable'Item) => : None
)

/*
  A stack of Items optimized for small amount of entries
  @param Item the trait of items
**/
SmallStack = proto AnyStack & struct(
    _self = this

    /**** Getters **************************************************************************/

    use capacity
    use count

    items(use self) => var ref items'data'self from self

    item(use self, index : Index) => var ref item(data'self, index) from self
    
    operator item=(@self, index : Index, value : Item) => {
        item(data'self, index) = value
    }

    /**** Methods **************************************************************************/

    push(@self, value : Item'self) => {
        ensureCapacity(@self, count'self + 1)

        oldItems = out data'self
        @count'self + 1 /*/ invalidates data'self
        data'self = PreallocBuffer'concat(out oldItems, [value])
    }

    pop(@self) => Item {
        ret = item(data'self, count'self - 1) /*/ copied out before the buffer goes

        oldItems = Array'items(out data'self, range(0, count'self - 1))
        @count'self -1 /*/ invalidates data'self
        data'self = PreallocBuffer(out oldItems)

        === ret
    }

    concat(@self, lists : Listable'Listable'Item) => None {
        newValuesCount = sum[count'list for list in lists]

        oldItems = out data'self
        @count'self + newValuesCount /*/ invalidates data'self
        data'self = PreallocBuffer'concat(out oldItems, concat'lists)
    }

    /**** Internal data *********************************************************************/

    SMALL_COUNT : Count

    _count : var Unsigned64
    _capacity : var Unsigned64
    _data : var PreallocBuffer

    /**** Internal Helpers *************************************************************/

    /* @returns Whether we need SOO **/
    _UsingSmall = self where capacity <= SMALL_COUNT

    /* @brief Bytes for unset values **/
    _ItemBytes = GarbageBytes(use size'Bytes'Item)

    /* @brief A buffer holding `count` items, reserved for `capacity` items **/
    _PreallocBuffer = proto (
        struct Array(Item, SMALL_COUNT) if self is UsingSmall
        else Array(Item, count) & GarbageBytes(
            size = size'Bytes'Item * (capacity-count)
        )
    )

    /*
      @brief Ensures that the stack has enough memory for the capacity,
      without modifying the items
    **/
    _ensureCapacity(@self, minCapacity : Unsigned64) => {
        if capacity'self < minCapacity and minCapacity > SMALL_COUNT'self {
            oldItems = out data'self
            capacity'self = minCapacity
            data'self = PreallocBuffer(out oldItems)
        }
    }
)

DEFAULT_SMALL_COUNT = Count'16

operator new SmallStack(Item : proto Any) => proto SmallStack(Item, DEFAULT_SMALL_COUNT)

operator new SmallStack(Item : proto Any, SMALL_COUNT : Count) => proto SmallStack(
    use proto Item
    use SMALL_COUNT
)

operator new SmallStack(list : Listable) => SmallStack(list, DEFAULT_SMALL_COUNT)

operator new SmallStack(list : Listable, SMALL_COUNT : Count) => SmallStack & (
    Item = proto Item'list
    use SMALL_COUNT
    count = count'list
    capacity = count'list
    data = PreallocBuffer'items'list
)